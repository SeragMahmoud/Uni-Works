<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36" version="24.8.2">
  <diagram name="Page-1" id="fHcIz-E-AX1XEm1DvNXX">
    <mxGraphModel dx="1687" dy="868" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ihwk4hHwUk9dkDl7nBdK-1" value="&lt;li style=&quot;font-size: 13px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;When the user clicks&lt;/strong&gt; the “Submit Payment” button on the payment page, the Controller captures the data entered by the user (e.g., amount, payment method, card details).&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 13px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;strong&gt;The Controller checks&lt;/strong&gt; the payment details for validation (e.g., is the amount positive, is the payment method supported).&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 13px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;strong&gt;If validation succeeds&lt;/strong&gt;, the Controller sends the payment information to the payment gateway for processing.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 13px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;strong&gt;The gateway responds&lt;/strong&gt; with the transaction result (success or failure).&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 13px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;strong&gt;The Controller updates&lt;/strong&gt; the Model with the result (e.g., the payment is successful, and the transaction ID is stored).&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 13px;&quot;&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;Finally, the Controller informs&lt;/strong&gt; the View about the result, so it can show the confirmation message or an error message to the user.&lt;/font&gt;&lt;/li&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="10" y="160" width="290" height="290" as="geometry" />
        </mxCell>
        <mxCell id="ihwk4hHwUk9dkDl7nBdK-2" value="" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;exitX=0.007;exitY=0.422;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="ihwk4hHwUk9dkDl7nBdK-7" target="ihwk4hHwUk9dkDl7nBdK-1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="359.0000000000001" y="281.99999999999994" as="sourcePoint" />
            <mxPoint x="510" y="368" as="targetPoint" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ihwk4hHwUk9dkDl7nBdK-3" value="&lt;li style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;Stores Payment Data&lt;/strong&gt;: Saves payment details (amount, method, status) in the database.&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;strong&gt;Transaction Status&lt;/strong&gt;: Records the status of each payment (e.g., success, failure, pending).&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;strong&gt;Validates Data&lt;/strong&gt;: Ensures that the stored payment data is correct (e.g., amount, payment method).&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;font-size: 16px;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;Provides Data&lt;/strong&gt;: Sends stored payment information to the Controller when needed (e.g., when the admin requests transaction history).&lt;/font&gt;&lt;/li&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="280" y="620" width="300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ihwk4hHwUk9dkDl7nBdK-5" value="&lt;p style=&quot;line-height: 140%; font-size: 18px;&quot;&gt;Controller&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="100" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ihwk4hHwUk9dkDl7nBdK-6" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;Model&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="560" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ihwk4hHwUk9dkDl7nBdK-7" value="&lt;div style=&quot;font-size: 14px;&quot;&gt;&lt;li&gt;&lt;strong&gt;The user visits&lt;/strong&gt; the payment page and fills in the required fields: payment amount, payment method (credit card, PayPal, etc.).&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Once the user submits&lt;/strong&gt; the payment, the View sends the user’s input to the Controller for processing.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;After the payment is processed&lt;/strong&gt;, the View shows the result: either a success message with a receipt or an error message if the transaction fails.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;If successful&lt;/strong&gt;, the View also displays a confirmation page with transaction details, such as the date and amount.&lt;/li&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="540" y="160" width="290" height="290" as="geometry" />
        </mxCell>
        <mxCell id="ihwk4hHwUk9dkDl7nBdK-8" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;View&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="100" width="290" height="60" as="geometry" />
        </mxCell>
