<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
                             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd" 
         version="3.0">

    <!-- Servlet Configuration -->
    <servlet>
        <servlet-name>SignupController</servlet-name>
        <servlet-class>Controller.SignupController</servlet-class>
        <load-on-startup>1</load-on-startup> <!-- Ensures the servlet loads on server startup -->
    </servlet>

    <!-- Servlet Mapping -->
    <servlet-mapping>
        <servlet-name>SignupController</servlet-name>
        <url-pattern>/signup</url-pattern> <!-- Updated for cleaner URL -->
    </servlet-mapping>

    <!-- Default Welcome File -->
    <welcome-file-list>
        <welcome-file>SignupPage.jsp</welcome-file>
    </welcome-file-list>
</web-app>