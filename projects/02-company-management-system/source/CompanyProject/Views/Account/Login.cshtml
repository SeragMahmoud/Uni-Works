@using Company.DAL.Entites
@model Account
@{
    ViewData["Title"] = "Login";
}



<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-primary text-white rounded-top-4">
                <h3 class="mb-0 text-center">
                    <i class="fas fa-sign-in-alt me-2"></i>Welcome Back
                </h3>
            </div>
            <div class="card-body p-4">
                <form asp-action="Login" method="post" novalidate>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control rounded-3" placeholder="example@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="Password" class="form-control rounded-3" type="password" placeholder="********" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success rounded-3 fw-bold">
                            <i class="fas fa-sign-in-alt me-1"></i> Login
                        </button>
                    </div>
                </form>

                <hr class="my-4" />

                <div class="text-center">
                    <p class="mb-0">Don't have an account?</p>
                    <a asp-controller="Account" asp-action="Create" class="btn btn-outline-primary mt-2 fw-bold">
                        <i class="fas fa-user-plus me-1"></i> Register Now
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @if (ViewBag.LoginError != null)
        {
            <text>
                    alert("@ViewBag.LoginError");
            </text>
        }
    </script>
}
