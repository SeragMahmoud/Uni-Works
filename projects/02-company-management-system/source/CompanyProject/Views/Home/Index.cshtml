@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center my-5">
    <h1 class="display-4 fw-bold text-primary">Company</h1>

</div>

<div class="container d-flex justify-content-center align-items-center flex-wrap gap-4">
    <!-- Employee Card -->
    <div class="card shadow-lg border-0" style="width: 18rem; transition: transform 0.3s;">
        <div class="card-body text-center">
            <i class="fas fa-user-tie fa-3x text-info mb-3"></i>
            <h5 class="card-title">Manage Employees</h5>
            <p class="card-text">Add, edit, and view employee details.</p>
            <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-info">Go to Employees</a>
        </div>
    </div>

    <!-- Department Card -->
    <div class="card shadow-lg border-0" style="width: 18rem; transition: transform 0.3s;">
        <div class="card-body text-center">
            <i class="fas fa-building fa-3x text-success mb-3"></i>
            <h5 class="card-title">Manage Departments</h5>
            <p class="card-text">Organize and manage departments efficiently.</p>
            <a asp-controller="Department" asp-action="Index" class="btn btn-outline-success">Go to Departments</a>
        </div>
    </div>
</div>

<!-- Hover effect -->
<style>
    .card:hover {
        transform: scale(1.05);
    }
</style>
